generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  documents Document[]
}

model Document {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User?          @relation(fields: [ownerId], references: [id])
  writingEvents WritingEvent[]
  shareLinks    ShareLink[]
}

model WritingEvent {
  id                  String   @id @default(cuid())
  documentId          String
  type                String
  timestamp           DateTime
  contentLengthChange Int
  wordCount           Int
  characterCount      Int
  textPreview         String?
  previousHash        String
  eventHash           String
  createdAt           DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([eventHash])
}

model ShareLink {
  id         String    @id @default(cuid())
  documentId String
  token      String    @unique
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}